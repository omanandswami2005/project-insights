# Copy to .env.local and fill in. Lanes B and C can work with NONE of these
# set — everything renders from lib/fixtures.js.

# Required for clustering, planning, translation (Lane A + C)
ANTHROPIC_API_KEY=

# Required for DeepSearch (Lane A)
TAVILY_API_KEY=

# Optional — raises the GitHub rate limit from 60/hr to 5000/hr.
# Verification works without it at demo volume.
GITHUB_TOKEN=

# Wave 2 — Telegram bot (F1)
TELEGRAM_BOT_TOKEN=

# THE DEMO SAFETY SWITCH.
# Set to 1 to render everything from lib/fixtures.js with no network calls at all.
# Verify this works before the pitch. If venue wifi dies, this saves the project.
NEXT_PUBLIC_USE_FIXTURES=0
