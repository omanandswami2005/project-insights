# Copy to .env.local and fill in your API key(s).

# PRIMARY LLM — NVIDIA NIM (Get free API key at build.nvidia.com)
NVIDIA_API_KEY=
# Blank = auto-detect the strongest available model from /v1/models.
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# OPENAI LLM (OpenAI cheapest model: gpt-4o-mini)
OPENAI_API_KEY=

# Standby LLM — Anthropic Claude
ANTHROPIC_API_KEY=

# Required for DeepSearch web enhancement (Lane A)
TAVILY_API_KEY=

# Optional — raises GitHub API rate limit from 60/hr to 5000/hr
GITHUB_TOKEN=

# Wave 2 — Telegram bot (F1)
TELEGRAM_BOT_TOKEN=

# THE DEMO SAFETY SWITCH.
# Set to 1 to force rendering everything from lib/fixtures.js with no network calls at all.
NEXT_PUBLIC_USE_FIXTURES=0
